{
  "info": {
    "name": "AppSec Regression - OWASP Juice Shop (API Controls V2)",
    "_postman_id": "22222222-2222-2222-2222-222222222222",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public - Product search (should be 200)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/products/search?q=apple"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "Identity - whoami without auth exposes no identity",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/user/whoami"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Juice Shop répond 200 avec un objet user vide quand on n'est pas authentifié.",
              "pm.test('Status 200, 401 or 403', () => pm.expect([200,401,403]).to.include(pm.response.code));",
              "pm.test('No identity exposed', () => {",
              "  let user = {};",
              "  try { user = pm.response.json().user || {}; } catch (e) { user = {}; }",
              "  pm.expect(user).to.not.have.property('email');",
              "});",
              "pm.test('No stack trace leaked', () => {",
              "  const body = (pm.response.text() || '').toLowerCase();",
              "  pm.expect(body).to.not.include('traceback');",
              "  pm.expect(body).to.not.include('exception');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Identity - whoami with USER token returns the user",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/user/whoami",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          },
          {
            "key": "Cookie",
            "value": "token={{user_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Juice Shop peut renvoyer {\"user\":{}} pour whoami avec un simple en-tête Bearer (l'interface web utilise un cookie).",
              "// Le contrôle porte donc sur l'identité portée par le jeton (payload JWT), et whoami ne doit jamais exposer une autre identité.",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Token identity matches the token owner (JWT payload)', () => {",
              "  const part = pm.environment.get('user_token').split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  const padded = part + '='.repeat((4 - (part.length % 4)) % 4);",
              "  const payload = JSON.parse(CryptoJS.enc.Base64.parse(padded).toString(CryptoJS.enc.Utf8));",
              "  pm.expect(payload.data.email).to.eql(pm.environment.get('user_email'));",
              "});",
              "pm.test('whoami never exposes another identity', () => {",
              "  let user = {};",
              "  try { user = pm.response.json().user || {}; } catch (e) { user = {}; }",
              "  if (user.email) { pm.expect(user.email).to.eql(pm.environment.get('user_email')); }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "AuthN - /api/Users without token is denied",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/Users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Denied (401 or 403)', () => pm.expect([401,403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "AuthN - /api/Users with USER token is allowed",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/Users",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "RBAC - accounting-only endpoint without token is denied",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/order-history/orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Denied (401 or 403)', () => pm.expect([401,403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "RBAC - accounting-only endpoint with USER token is denied",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/order-history/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Denied (401 or 403)', () => pm.expect([401,403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "RBAC - accounting-only endpoint with ACCOUNTING token is allowed",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/rest/order-history/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accounting_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    }
  ]
}
