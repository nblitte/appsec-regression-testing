{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["base_url", "login_path", "dashboard_path", "admin_path", "test_users", "api"],
  "properties": {
    "base_url": { "type": "string" },
    "login_path": { "type": "string" },
    "dashboard_path": { "type": "string" },
    "admin_path": { "type": "string" },
    "test_users": {
      "type": "object",
      "required": ["standard", "accounting"],
      "properties": {
        "standard": {
          "type": "object",
          "required": ["username", "password"],
          "properties": { "username": { "type": "string" }, "password": { "type": "string" } }
        },
        "accounting": {
          "type": "object",
          "required": ["username", "password"],
          "properties": { "username": { "type": "string" }, "password": { "type": "string" } }
        }
      }
    },
    "api": {
      "type": "object",
      "required": ["base_url", "public_endpoint", "protected_endpoint", "rbac_endpoint"],
      "properties": {
        "base_url": { "type": "string" },
        "public_endpoint": { "type": "string" },
        "protected_endpoint": { "type": "string" },
        "rbac_endpoint": { "type": "string" }
      }
    }
  }
}
